---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/urls';

const { title = 'רברס עם פלטפורמה', description = 'פודקאסט על תוכנה, מוצר, ותשתיות — בעברית.', canonical } = Astro.props;
// GitHub Pages serves every page at both /x and /x.html. Point Google at the .html form,
// which matches the legacy Blogger URLs and the internal links.
function canonicalPath(pathname: string) {
	if (pathname === '/' || pathname === '' || pathname === '/index.html') return '/';
	return `${pathname.replace(/\/$/, '').replace(/\.html$/, '')}.html`;
}
const canonicalUrl = new URL(canonical ?? canonicalPath(Astro.url.pathname), Astro.site).href;
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-Y4CQKFBQGR';
---

<html lang="he" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Hebrew:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
		{
			import.meta.env.PROD && (
				<>
					<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
					<script
						is:inline
						set:html={`
							window.dataLayer = window.dataLayer || [];
							function gtag(){dataLayer.push(arguments);}
							gtag('js', new Date());
							gtag('config', '${gaId}');
						`}
					/>
					<script
						is:inline
						set:html={`
							(function () {
								var ENDPOINT = 'https://m2.reversim.com/_e'; // private cookieless counter, see analytics/worker
								try {
									if (navigator.webdriver || !navigator.sendBeacon) return;
									var path = location.pathname, played = false, ref = '';
									var send = function (o) {
										try { navigator.sendBeacon(ENDPOINT, new Blob([JSON.stringify(o)], { type: 'text/plain' })); } catch (e) {}
									};
									try { ref = new URL(document.referrer).hostname.toLowerCase(); } catch (e) {}
									if (ref === location.hostname.toLowerCase()) ref = '';
									send({ t: 'pv', p: path, r: ref });
									var play = function () { if (!played) { played = true; send({ t: 'play', p: path }); } };
									// 'play' does not bubble, so listen in the capture phase.
									document.addEventListener('play', function (e) { if (e.target && e.target.tagName === 'AUDIO') play(); }, true);
									// Many old posts only link to the mp3: count a click on such a link as a play.
									document.addEventListener('click', function (e) {
										var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
										if (a && /[.]mp3([?#]|$)/i.test(a.getAttribute('href'))) play();
									}, true);
								} catch (e) {}
							})();
						`}
					/>
				</>
			)
		}
	</head>
	<body>
		<Header />
		<main id="content" class="site-main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
