---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, getPostPermalink } from '../lib/posts';
import { catalog } from '../lib/catalog';
import { SHOW_LINKS } from '../lib/links';

const posts = (await getAllPosts()).filter((post) => post.data.audio_url);
const [latest] = posts;
const latestLink = latest ? getPostPermalink(latest) : '#';
const initialCount = 12;
const initialPosts = posts.slice(1, initialCount + 1);
// The page holds 60 episodes at most; the full list is on /episodes.html. (All 800 cards made a 1.3 MB page.)
const deferredPosts = posts.slice(initialCount + 1, 61);
const latestHook = latest ? catalog[latest.id]?.hook : undefined;
const site = String(Astro.site);
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'PodcastSeries',
		name: 'רברס עם פלטפורמה',
		alternateName: ['Reversim', 'Reversim Podcast', 'רברסים'],
		description: 'פודקאסט בעברית למפתחות ולמפתחי תוכנה: ארכיטקטורה, תשתיות, AI, ניהול הנדסה וקריירה. משדרים מאז 2009.',
		url: site,
		inLanguage: 'he',
		image: new URL('/podcast-cover.png', Astro.site).href,
		webFeed: SHOW_LINKS.feed,
		sameAs: [SHOW_LINKS.spotify, SHOW_LINKS.apple, SHOW_LINKS.deezer, SHOW_LINKS.x, SHOW_LINKS.summit],
		author: [{ '@type': 'Person', name: 'Ran Tavory' }, { '@type': 'Person', name: 'Ori Lahav' }],
	},
	{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'רברס עם פלטפורמה', alternateName: 'Reversim', url: site, inLanguage: 'he' },
];
---

<BaseLayout
	title="רברס עם פלטפורמה — פודקאסט למפתחי תוכנה, בעברית"
	description={`פודקאסט בעברית למפתחות ולמפתחי תוכנה, מאז 2009: פרקים על ארכיטקטורה, תשתיות, AI, ניהול הנדסה וקריירה — עם סיכומים, תמלולים וקישורים.`}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
	<section class="hero">
		<div class="hero-copy">
			<h1>הפודקאסט של מפתחי התוכנה בישראל. מאז 2009.</h1>
			<p>
				רן תבורי ואורי להב מארחים את האנשים שבונים את התוכנה שמאחורי ההייטק הישראלי.
				פרקים על ארכיטקטורה, תשתיות, AI, ניהול הנדסה וקריירה — עם סיכומים, תמלולים וקישורים.
			</p>
			<div class="hero-actions">
				{latest && <a class="cta" href={latestLink}>האזנה לפרק האחרון</a>}
				<a class="cta cta-secondary" href="/start-here.html">חדשים כאן? מאיפה מתחילים</a>
			</div>
			<div class="hero-platforms">
				<a href={SHOW_LINKS.spotify} target="_blank" rel="noreferrer noopener">Spotify</a>
				<a href={SHOW_LINKS.apple} target="_blank" rel="noreferrer noopener">Apple Podcasts</a>
				<a href={SHOW_LINKS.feed}>RSS</a>
			</div>
		</div>
		{latest && (
			<div class="hero-latest">
				<p class="section-title">הפרק האחרון</p>
				<article class="post-card">
					{latest.data.cover_image && (
						<a class="hero-latest-cover" href={latestLink} aria-label={latest.data.title}>
							<img src={latest.data.cover_image} alt={latest.data.title} decoding="async" />
						</a>
					)}
					<div class="post-meta">
						<span>{latest.data.date.toLocaleDateString('he-IL', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
						{latest.data.episode && <span>פרק {latest.data.episode}</span>}
					</div>
					<h2 class="hero-latest-title" dir="auto"><a href={latestLink} dir="auto">{latest.data.title}</a></h2>
					{latestHook && <p>{latestHook}</p>}
					<div class="audio-player">
						<audio controls preload="none" src={latest.data.audio_url}></audio>
					</div>
				</article>
			</div>
		)}
	</section>

	<section>
		<h2 class="section-title">פרקים אחרונים</h2>
		<div id="home-posts-grid" class="posts-grid posts-grid-home">
			{initialPosts.map((post) => (
				<PostCard post={post} />
			))}
		</div>
		{
			deferredPosts.length > 0 && (
				<div class="episodes-load-more-wrap">
					<button id="home-load-more" class="episodes-load-more" type="button">
						טען עוד פרקים
					</button>
				</div>
			)
		}
		<div id="home-deferred-cards" hidden>
			{deferredPosts.map((post) => (
				<PostCard post={post} />
			))}
		</div>
		<p class="home-all-link"><a href="/episodes.html">לכל הפרקים</a> · <a href="/archive.html">ארכיון לפי שנה</a></p>
	</section>
	<script is:inline>
		(() => {
			const grid = document.getElementById('home-posts-grid');
			const button = document.getElementById('home-load-more');
			const deferred = document.getElementById('home-deferred-cards');

			if (!grid || !button || !deferred) return;

			const pageSize = 12;

			const renderNextBatch = () => {
				const cards = Array.from(deferred.querySelectorAll('.post-card')).slice(0, pageSize);
				if (!cards.length) {
					button.remove();
					return;
				}

				const fragment = document.createDocumentFragment();
				cards.forEach((card) => fragment.appendChild(card));
				grid.appendChild(fragment);

				if (!deferred.querySelector('.post-card')) button.remove();
			};

			button.addEventListener('click', renderNextBatch);
		})();
	</script>
</BaseLayout>
