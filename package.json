    "@astrojs/rss": "^4.0.18",
    "astro": "^7.4.13",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.3.5",
    "marked": "^18.0.3",
    "p-limit": "^6.2.0",
    "pagefind": "^1.4.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.35.5",
    "yaml": "^2.6.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
