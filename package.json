{
  "name": "reversim-podcast",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/legacy-archive-dirs.mjs dist && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "migrate:blogger": "node scripts/migrate-from-blogger.mjs",
    "images:localize-blogger": "node scripts/localize-blogger-images.mjs",
    "migrate:validate": "node scripts/validate-migration.mjs",
    "migrate:audit": "node scripts/audit-migration.mjs",
    "rss:compare": "node scripts/compare-rss.mjs",
    "post-production": "node scripts/post-production.mjs",
